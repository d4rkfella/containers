{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["regex"],
  "regexManagers": [
    {
      "fileMatch": ["^.*apko\\.yaml$"],
      "matchStrings": [
        "packages:\\s+-\\s+(?<depName>[^=]+)=(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "apk",
      "versioning": "apk",
      "registryUrls": [
        "https://packages.darkfellanetwork.com/wolfi-os",
        "https://packages.wolfi.dev/os"
      ]
    }
  ],
  "hostRules": [
    {
      "hostType": "apk",
      "matchHost": "packages.darkfellanetwork.com"
      // Add auth here if needed (see below)
    }
  ],
  "packageRules": [
    {
      "description": "Automerge safe updates",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": false
    },
    {
      "description": "Group all APK updates together",
      "matchDatasources": ["apk"],
      "groupName": "APK package updates",
      "schedule": ["before 5am on monday"]
    }
  ],
  "dependencyDashboard": true
}
